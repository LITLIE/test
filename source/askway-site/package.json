{
  "name": "askway-official-site",
  "version": "3.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/unit.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:regressions": "node tests/regressions.mjs",
    "test:download": "node tests/download.mjs",
    "test:experience": "node --experimental-strip-types --test tests/experience/*.test.mjs",
    "test:workbench": "node tests/experience/workbench-regressions.mjs",
    "test:scene": "node tests/experience/scene-browser.mjs",
    "test:quality": "node tests/experience/quality.mjs",
    "test:static": "node tests/experience/static-site.mjs",
    "test:visual": "node tests/experience/visual-refresh-browser.mjs",
    "test:cinematic": "node --experimental-strip-types --test tests/cinematic/*.test.mjs",
    "test:cinematic:browser": "node tests/cinematic/browser.mjs",
    "capture:cinematic": "node scripts/capture-cinematic.mjs",
    "sync:publication": "node scripts/sync-publication.mjs"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.2",
    "axe-core": "4.14.1",
    "lighthouse": "13.6.0",
    "playwright-core": "1.65.1",
    "typescript": "5.5.4",
    "vite": "5.4.21"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
